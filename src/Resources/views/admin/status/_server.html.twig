{# @var server_information \Setono\SyliusMeilisearchPlugin\Meilisearch\Server\ServerInformation #}
{% set healthy = server_information.healthy %}
<div class="ui {{ healthy ? 'green' : 'red' }} segment">
    <h3 class="ui header">
        {% if healthy %}
            <i class="circular inverted green check icon"></i>
        {% else %}
            <i class="circular inverted red times icon"></i>
        {% endif %}
        <div class="content">
            {{ (healthy ? 'setono_sylius_meilisearch.ui.server_available' : 'setono_sylius_meilisearch.ui.server_unavailable')|trans }}
            <div class="sub header">
                {% if healthy %}
                    {% set meta = [] %}
                    {% if server_information.version is not null %}
                        {% set meta = meta|merge([('setono_sylius_meilisearch.ui.version'|trans) ~ ' ' ~ server_information.version]) %}
                    {% endif %}
                    {% if server_information.lastUpdate is not null %}
                        {% set meta = meta|merge([('setono_sylius_meilisearch.ui.last_update'|trans) ~ ' ' ~ server_information.lastUpdate|date('Y-m-d H:i:s')]) %}
                    {% endif %}
                    {{ meta|join(' · ') }}
                {% else %}
                    {{ 'setono_sylius_meilisearch.ui.server_unreachable'|trans }}
                {% endif %}
            </div>
        </div>
    </h3>
</div>

{% if healthy and server_information.indexes is not empty %}
    <table class="ui celled table">
        <thead>
            <tr>
                <th>{{ 'setono_sylius_meilisearch.ui.index'|trans }}</th>
                <th>{{ 'setono_sylius_meilisearch.ui.index_uid'|trans }}</th>
                <th>{{ 'setono_sylius_meilisearch.ui.number_of_documents'|trans }}</th>
                <th>{{ 'setono_sylius_meilisearch.ui.is_indexing'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% for name, statuses in server_information.indexes %}
                {% for status in statuses %}
                    <tr>
                        <td>{{ name|title }}</td>
                        <td>{{ status.uid }}</td>
                        {% if status.existsOnServer %}
                            <td>{{ status.numberOfDocuments ?? '?' }}</td>
                            <td>
                                {% if status.isIndexing %}
                                    <i class="sync alternate icon"></i>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                        {% elseif server_information.statsAvailable %}
                            <td colspan="2">
                                <span class="ui red small label">{{ 'setono_sylius_meilisearch.ui.missing_on_server'|trans }}</span>
                            </td>
                        {% else %}
                            <td colspan="2">—</td>
                        {% endif %}
                    </tr>
                {% endfor %}
            {% endfor %}
        </tbody>
    </table>
{% endif %}
